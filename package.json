{
  "name": "slop-kazan",
  "private": true,
  "type": "module",
  "packageManager": "aube@2.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "vite build",
    "deploy": "aube run build && CLOUDFLARE_ACCOUNT_ID=7f1bb3dfed48a390e1bcf9e1ac54305c wrangler pages deploy --env-file .cloudflare/pages.env --project-name slop-kazan --branch ${KAZAN_PAGES_BRANCH:-feat/kazan-tatarstan}",
    "preview": "vite preview",
    "geodata": "node tools/build-kazan-geodata.mjs",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "devDependencies": {
    "polygon-clipping": "0.15.7",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "three": "github:mrdoob/three.js#2bd920c3a604a3b847d9187b0a1c21e33807ecb3"
  }
}
